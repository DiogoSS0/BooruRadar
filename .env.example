BOORURADAR_ENVIRONMENT=development
BOORURADAR_DEBUG=false
BOORURADAR_LOG_LEVEL=INFO
BOORURADAR_DATABASE_URL=postgresql+psycopg://booruradar:booruradar@localhost:5432/booruradar
BOORURADAR_HTTP_TIMEOUT_SECONDS=10
BOORURADAR_WORKER_POLL_INTERVAL_SECONDS=60
BOORURADAR_API_HOST=127.0.0.1
BOORURADAR_API_PORT=8000

# Optional official Danbooru HTTP Basic Auth. Both values are required.
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# Used by the local PostgreSQL service in compose.yaml.
POSTGRES_DB=booruradar
POSTGRES_USER=booruradar
POSTGRES_PASSWORD=booruradar
POSTGRES_PORT=5432
